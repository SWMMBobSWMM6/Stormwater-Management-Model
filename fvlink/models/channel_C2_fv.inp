[TITLE]
uniform channel

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             12:00:00
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             00:05:00
ROUTING_STEP         5
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         12.566
SURCHARGE_METHOD     SLOT
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
ALLOW_PONDING        NO
HEAD_TOLERANCE       0.005
MAX_TRIALS           8
THREADS              1

[JUNCTIONS]
;;Name Elev MaxDepth InitDepth SurDepth Aponded
J1           100.000   8.00  0.000   0.00 0
J2            99.000   8.00  0.000   0.00 0
J3            97.000   8.00  0.000   0.00 0

[OUTFALLS]
;;Name Elev Type StageData Gated
O1 96.000 NORMAL  NO

[CONDUITS]
;;Name From To Length n InOff OutOff InitFlow MaxFlow
C1       J1       J2        1000.00 0.0150  0.000  0.000 0 0
C2       J2       J3        2000.00 0.0150  0.000  0.000 0 0
C3       J3       O1        1000.00 0.0150  0.000  0.000 0 0

[XSECTIONS]
;;Link Shape G1 G2 G3 G4 Barrels
C1 RECT_OPEN 6.0 10.0 0 0 1
C2 RECT_OPEN 6.0 10.0 0 0 1
C3 RECT_OPEN 6.0 10.0 0 0 1

[INFLOWS]
;;Node Constituent TimeSeries Type Mfactor Sfactor Baseline Pattern
J1 FLOW CONST FLOW 1.0 1.0

[TIMESERIES]
CONST 0.0 60.0
CONST 12.0 60.0

[REPORT]
INPUT NO
CONTROLS NO
NODES ALL
LINKS ALL

[FV_LINKS]
;;Link Cells
C2 80
