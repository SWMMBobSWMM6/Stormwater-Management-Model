+double celerity(const TFvLink* f, double h)
+//
+//  Purpose: gravity wave celerity sqrt(g*A/W) at depth h (0 when dry).
+//
+{
+    double a, w;
+    if ( h <= 0.0 ) return 0.0;
+    a = areaOf(f, h);
+    w = widthOf(f, h);
+    if ( a <= f->aEps || w <= 0.0 ) return 0.0;
+    return sqrt(GRAVITY * a / w);
+}
+
+//=============================================================================
+
+void criticalEntrance(const TFvLink* f, double e, double* h, double* u)
+//
+//  Input:   e = node head above the face's reconstructed bed (ft)
+//  Output:  h, u = critical depth (ft) and velocity (ft/sec) for specific
+//           energy e, h + A/(2W) = e
+//
+{
+    int    k;
+    double lo = 0.0, hi = e, mid, c;
+    if ( e <= 0.0 ) { *h = 0.0; *u = 0.0; return; }
+    for (k = 0; k < 40; k++)
+    {
+        mid = 0.5 * (lo + hi);
+        c = celerity(f, mid);
+        if ( mid + c * c / (2.0 * GRAVITY) > e ) hi = mid;
+        else lo = mid;
+    }
+    *h = lo;
+    *u = celerity(f, lo);
+}
