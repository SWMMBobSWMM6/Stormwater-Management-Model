 //=============================================================================
 
+static double waveSpeed(const TFvLink* f, double h, double a)
+//
+//  Purpose: gravity wave celerity sqrt(g*A/W) at depth h (0 when dry).
+//
+{
+    double w;
+    if ( h <= 0.0 || a <= f->aEps ) return 0.0;
+    w = widthOf(f, h);
+    if ( w <= 0.0 ) return 0.0;
+    return sqrt(GRAVITY * a / w);
+}
